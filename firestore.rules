rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // El permiso se asigna desde un entorno confiable con Firebase Admin SDK.
    // Nunca se confía en un campo enviado por el navegador.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Las consultas públicas deben incluir where('isActive', isEqualTo: true).
    // Firestore valida la consulta completa y no filtra documentos después.
    function isActiveCatalogDocument() {
      return resource.data.isActive == true;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name',
          'category',
          'unitLabel',
          'basePrice',
          'isActive',
          'isFeatured',
          'sortOrder',
          'stockStatus',
          'leadDays',
          'productionPoints',
          'variants'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.category in ['materials', 'bouquets', 'personalized_gifts']
        && data.unitLabel is string
        && data.unitLabel.size() > 0
        && data.unitLabel.size() <= 40
        && data.basePrice is number
        && data.basePrice >= 0
        && data.basePrice <= 1000000
        && data.isActive is bool
        && data.isFeatured is bool
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 1000000
        && data.stockStatus in [
          'in_stock',
          'low_stock',
          'out_of_stock',
          'made_to_order',
          'check_availability'
        ]
        && data.leadDays is int
        && data.leadDays >= 0
        && data.leadDays <= 365
        && data.productionPoints is int
        && data.productionPoints >= 0
        && data.productionPoints <= 1000000
        && data.variants is list
        && data.variants.size() <= 250
        && (!('stock' in data) ||
          (data.stock is int && data.stock >= 0 && data.stock <= 100000000))
        && (!('description' in data) ||
          (data.description is string && data.description.size() <= 3000))
        && (!('sku' in data) ||
          (data.sku is string && data.sku.size() <= 100));
    }

    function isValidPublicSettings(data) {
      return data.keys().hasAll([
          'businessName',
          'whatsappNumberE164',
          'pickupCity',
          'shippingProvider'
        ])
        && data.keys().hasOnly([
          'businessName',
          'locale',
          'currency',
          'whatsappNumberE164',
          'whatsappGreeting',
          'pickupCity',
          'shippingProvider',
          'quoteDisclaimer',
          'catalogVersion',
          'updatedAt'
        ])
        && data.businessName is string
        && data.businessName.size() > 0
        && data.businessName.size() <= 100
        && data.whatsappNumberE164 is string
        && data.whatsappNumberE164.size() <= 20
        && data.pickupCity is string
        && data.pickupCity.size() <= 100
        && data.shippingProvider is string
        && data.shippingProvider.size() <= 100;
    }

    function isValidAvailability(data) {
      return data.keys().hasAll([
          'timezone',
          'horizonDays',
          'weeklyCapacityPoints',
          'reservedPointsByDate',
          'overridesByDate'
        ])
        && data.keys().hasOnly([
          'timezone',
          'horizonDays',
          'weeklyCapacityPoints',
          'reservedPointsByDate',
          'overridesByDate',
          'updatedAt'
        ])
        && data.timezone == 'America/Lima'
        && data.horizonDays is int
        && data.horizonDays >= 1
        && data.horizonDays <= 365
        && data.weeklyCapacityPoints is map
        && data.weeklyCapacityPoints.keys().hasAll([
          '1', '2', '3', '4', '5', '6', '7'
        ])
        && data.weeklyCapacityPoints.keys().hasOnly([
          '1', '2', '3', '4', '5', '6', '7'
        ])
        && isValidCapacityPoints(data.weeklyCapacityPoints['1'])
        && isValidCapacityPoints(data.weeklyCapacityPoints['2'])
        && isValidCapacityPoints(data.weeklyCapacityPoints['3'])
        && isValidCapacityPoints(data.weeklyCapacityPoints['4'])
        && isValidCapacityPoints(data.weeklyCapacityPoints['5'])
        && isValidCapacityPoints(data.weeklyCapacityPoints['6'])
        && isValidCapacityPoints(data.weeklyCapacityPoints['7'])
        && data.reservedPointsByDate is map
        && data.reservedPointsByDate.size() <= 366
        && data.overridesByDate is map
        && data.overridesByDate.size() <= 366
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidCapacityPoints(value) {
      return value is int && value >= 0 && value <= 100000;
    }

    function validOptionalId(data, field) {
      return !(field in data) ||
        (data[field] is string &&
         data[field].size() > 0 &&
         data[field].size() <= 100 &&
         data[field].matches('^[A-Za-z][A-Za-z0-9_.-]*$'));
    }

    function isValidSearchTerm(value) {
      return value is string
        && value.size() >= 2
        && value.size() <= 48
        && value.matches('^[a-z0-9áéíóúüñ# +./-]+$')
        && !value.matches('.*[0-9]{5,}.*')
        && !value.matches('.*([0-9][ +().-]*){7,}.*')
        && !value.matches('.*(https|www[.]).*')
        && !value.matches(
          '.*(dni|ruc|teléfono|telefono|celular|whatsapp|correo|email|dirección|direccion|avenida|jirón|jiron|calle|pasaje|urbanización|urbanizacion|me llamo|mi nombre).*'
        )
        && !value.matches('(^|.* )(av|jr)([ .].*|$)');
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll([
          'eventType',
          'day',
          'schemaVersion',
          'occurredAt'
        ])
        && data.eventType in [
          'zero_result_search',
          'product_view',
          'product_added',
          'quote_abandoned',
          'quote_sent'
        ]
        && data.day is string
        && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.schemaVersion == 1
        && data.occurredAt == request.time
        && validOptionalId(data, 'productId')
        && validOptionalId(data, 'variantId')
        && (
          (data.eventType == 'zero_result_search'
            && data.keys().hasOnly([
              'eventType', 'day', 'schemaVersion', 'occurredAt', 'searchTerm'
            ])
            && 'searchTerm' in data
            && isValidSearchTerm(data.searchTerm))
          || (data.eventType == 'product_view'
            && data.keys().hasOnly([
              'eventType', 'day', 'schemaVersion', 'occurredAt',
              'productId', 'variantId'
            ])
            && 'productId' in data)
          || (data.eventType == 'product_added'
            && data.keys().hasOnly([
              'eventType', 'day', 'schemaVersion', 'occurredAt',
              'productId', 'variantId', 'quantityBucket'
            ])
            && 'productId' in data
            && data.quantityBucket in [
              '1', '2-5', '6-11', '12-49', '50-99', '100+'
            ])
          || (data.eventType == 'quote_abandoned'
            && data.keys().hasOnly([
              'eventType', 'day', 'schemaVersion', 'occurredAt',
              'itemCountBucket', 'valueBucket', 'abandonmentHoursBucket'
            ])
            && data.itemCountBucket in ['1', '2-3', '4-6', '7+']
            && data.valueBucket in [
              '0-49', '50-99', '100-249', '250-499', '500+'
            ]
            && data.abandonmentHoursBucket in [
              '24-71', '72-167', '168+'
            ])
          || (data.eventType == 'quote_sent'
            && data.keys().hasOnly([
              'eventType', 'day', 'schemaVersion', 'occurredAt',
              'itemCountBucket', 'valueBucket'
            ])
            && (!('itemCountBucket' in data) ||
              data.itemCountBucket in ['1', '2-3', '4-6', '7+'])
            && (!('valueBucket' in data) ||
              data.valueBucket in [
                '0-49', '50-99', '100-249', '250-499', '500+'
              ]))
        );
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin() || isActiveCatalogDocument();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if isAdmin() || isActiveCatalogDocument();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Los clientes solo leen estos documentos; el panel puede actualizarlos.
    match /settings/public {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() && isValidPublicSettings(request.resource.data);
      allow delete: if false;
    }

    // Un único documento compacto con el horizonte público de fechas. Las
    // validaciones de capacidad se calculan en backend/panel, no en el cliente.
    match /availability/public {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() &&
        isValidAvailability(request.resource.data);
      allow delete: if false;
    }

    // Métricas anónimas con esquema cerrado. El panel administra su lectura;
    // el cliente público nunca puede consultar eventos de otras personas.
    match /analytics_events/{eventId} {
      allow create: if isValidAnalyticsEvent(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Cualquier colección o subcolección no declarada queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
