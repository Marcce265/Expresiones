/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  X-Robots-Tag: noai, noimageai
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), usb=(), browsing-topics=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.gstatic.com https://fonts.gstatic.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; img-src 'self' data: blob: https://*.supabase.co https://tile.openstreetmap.org https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noai, noimageai

# Assets del build. Una semana reduce descargas repetidas sin dejar una
# portada antigua pegada durante meses.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

# El directorio cambia sin modificar su URL. Debe revalidarse para no mostrar
# agencias cerradas o coordenadas antiguas después de una sincronización.
/assets/assets/data/shalom_agencies.json
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

# Flutter Web genera MaterialIcons con tree-shaking y manifiestos con URL fija.
# Revalidarlos evita que íconos recién agregados se vean invisibles en caché.
/assets/fonts/MaterialIcons-Regular.otf
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/assets/FontManifest.json
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/assets/AssetManifest.bin.json
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/admin/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/admin/assets/fonts/MaterialIcons-Regular.otf
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/admin/assets/FontManifest.json
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/admin/assets/AssetManifest.bin.json
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/canvaskit/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/admin/canvaskit/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/admin/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/admin/favicon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

# El bundle principal cambia con cada deploy y su URL lleva ?v=<build>.
/main.dart.js
  Cache-Control: public, max-age=31536000, immutable

/admin/main.dart.js
  Cache-Control: public, max-age=31536000, immutable

# Shells, manifiestos y service worker: se revalidan con ETag para no servir
# una versión vieja, pero sin volver a descargar el cuerpo si no cambió.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/privacy.html
  Cache-Control: no-cache, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, must-revalidate

/flutter.js
  Cache-Control: no-cache, must-revalidate

/flutter_service_worker.js
  Cache-Control: no-cache, must-revalidate

/version.json
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

/admin/
  Cache-Control: no-cache, must-revalidate

/admin/index.html
  Cache-Control: no-cache, must-revalidate

/admin/flutter_bootstrap.js
  Cache-Control: no-cache, must-revalidate

/admin/flutter.js
  Cache-Control: no-cache, must-revalidate

/admin/flutter_service_worker.js
  Cache-Control: no-cache, must-revalidate

/admin/version.json
  Cache-Control: no-cache, must-revalidate

/admin/manifest.json
  Cache-Control: no-cache, must-revalidate
